# Host address and port published by Docker Compose.
# Set MUGI_BIND=0.0.0.0 to allow LAN access.
MUGI_BIND=127.0.0.1
MUGI_PORT=8080

# Optional: set to ghcr.io/foliagesea/mugi:<release-tag> to use a published image.
# Then run docker compose pull and docker compose up -d --no-build.
# MUGI_IMAGE=

# true: HTTPS with a persistent self-signed certificate; false: HTTP.
# TLS uses the same container port (8080). Set MUGI_PORT=8443 if desired.
MUGI_TLS=false

# auto: classify by client IP; local: allow ADB; external: WebUSB only.
# Use external when exposing mugi through an frpc TCP proxy.
MUGI_ACCESS_MODE=auto
