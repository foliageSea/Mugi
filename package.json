{
  "name": "mugi",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build:packages": "npm run build --workspace @mugi/web-adb",
    "dev": "npm run build:packages && vite --config web/vite.config.ts",
    "typecheck": "npm run build:packages && vue-tsc --noEmit -p web/tsconfig.json",
    "build": "npm run typecheck && vite build --config web/vite.config.ts",
    "build:windows": "node scripts/build-windows.mjs",
    "build:macos": "node scripts/build-macos.mjs",
    "test": "npm run test --workspace @mugi/web-adb && node --test web/src/lib/scrcpy/*.test.js",
    "test:package": "npm run build:packages && node scripts/test-web-adb-package.mjs",
    "pretest:e2e": "npm run build:packages",
    "test:e2e": "playwright test --config web/playwright.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "format": "prettier --write \"web/src/**/*.{vue,ts,css}\" \"web/*.ts\" \"web/tests/*.ts\" \"packages/web-adb/{src,scripts,tests}/**/*.{ts,js,mjs}\"",
    "format:check": "prettier --check \"web/src/**/*.{vue,ts,css}\" \"web/*.ts\" \"web/tests/*.ts\" \"packages/web-adb/{src,scripts,tests}/**/*.{ts,js,mjs}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "prettier": "^3.9.9",
    "shadcn-vue": "^2.8.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@mugi/web-adb": "^0.1.0",
    "@lucide/vue": "^1.47.0",
    "@unovis/vue": "^1.7.0",
    "@vueuse/core": "^15.0.0",
    "@wailsio/runtime": "3.0.0-beta.28",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "plyr": "^3.8.4",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "v-viewer": "^3.0.23",
    "viewerjs": "1.15.2",
    "vue": "^3.5.43",
    "vue-sonner": "^2.0.9"
  }
}
